# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Optional: public site URL used for email confirmation redirects (defaults to request origin)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# NOTE: the Supabase service-role key is intentionally NOT used anywhere in this app.
# Never add it to a NEXT_PUBLIC_* variable.
